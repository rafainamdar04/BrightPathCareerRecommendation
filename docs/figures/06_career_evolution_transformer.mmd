flowchart TD
    %% Career Evolution Algorithm (Transformer-based)
    
    Start([User Requests Evolution]) --> Input["Collect Inputs<br/>• User profile (28 features)<br/>• Current career role<br/>• Career history"]
    
    Input --> EncodeRole["Encode Career Role<br/>LabelEncoder<br/>Role → Integer ID"]
    
    EncodeRole --> EmbedSeq["Embedding Layer<br/>Career sequence<br/>→ 128-dim vectors"]
    
    EmbedSeq --> PosEnc["Positional Encoding<br/>Add position info<br/>PE = sin/cos functions"]
    
    PosEnc --> SelfAttn["Multi-Head Self-Attention<br/>4 attention heads<br/>Key dim: 64<br/>Learn role relationships"]
    
    SelfAttn --> AddNorm1["Add & Normalize<br/>Residual connection<br/>LayerNorm"]
    
    AddNorm1 --> FFN["Feed-Forward Network<br/>Dense(128) → ReLU → Dense(64)"]
    
    FFN --> AddNorm2["Add & Normalize<br/>Second residual"]
    
    AddNorm2 --> CrossAttn["Cross-Attention<br/>Query: Career sequence<br/>Key/Value: User features<br/>Personalization layer"]
    
    CrossAttn --> Dense1["Dense Layer 1<br/>256 neurons<br/>ReLU + Dropout(0.3)"]
    
    Dense1 --> Dense2["Dense Layer 2<br/>128 neurons<br/>ReLU + Dropout(0.2)"]
    
    Dense2 --> Output["Output Layer<br/>Softmax(n_careers)<br/>Predict next roles"]
    
    Output --> TopK["Select Top-K<br/>Next 3 career stages<br/>with probabilities"]
    
    TopK --> TimeModel["Time Prediction Model<br/>Estimate transition years<br/>Based on user profile"]
    
    TimeModel --> BuildPath["Build Evolution Path<br/>Stage 1 → Stage 2 → Stage 3<br/>With timeframes"]
    
    BuildPath --> Confidence["Calculate Confidence<br/>Per transition<br/>Based on attention weights"]
    
    Confidence --> Format["Format Response<br/>• Career stages<br/>• Timeframes<br/>• Confidence scores<br/>• Natural language desc"]
    
    Format --> End([Return Evolution Path])
    
