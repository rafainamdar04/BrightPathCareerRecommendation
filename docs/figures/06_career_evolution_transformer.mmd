flowchart TD
    %% Career Evolution Algorithm (Transformer-based) - Simplified
    
    Start([User Requests Evolution]) --> Input["Collect Inputs<br/>User profile + Current role"]
    
    Input --> Encode["Encode & Embed<br/>Role → Vector (128-dim)<br/>+ Positional encoding"]
    
    Encode --> Attention["Transformer Processing<br/>Multi-head self-attention<br/>Cross-attention with profile<br/>Feed-forward network"]
    
    Attention --> Predict["Predict Next Stages<br/>Softmax output<br/>Select top-3 roles"]
    
    Predict --> Timeline["Add Timeframes<br/>Estimate transition years<br/>Calculate confidence"]
    
    Timeline --> Format["Format Evolution Path<br/>Stage 1 → Stage 2 → Stage 3<br/>With years and confidence"]
    
    Format --> End([Return Evolution Path])
    
