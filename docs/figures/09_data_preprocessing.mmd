flowchart TD
    %% Data Preprocessing Pipeline - Simplified
    
    Start([Raw Dataset]) --> Load["Load CSV<br/>20,000 samples<br/>28 features + target"]
    
    Load --> Split_Types["Split Feature Types<br/>14 Numerical<br/>14 Categorical"]
    
    Split_Types --> Process_Num["Process Numerical<br/>Standard scaling<br/>z = (x - μ) / σ"]
    Split_Types --> Process_Cat["Process Categorical<br/>One-hot encoding<br/>63 dimensions"]
    
    Process_Num --> Combine["Combine Features<br/>Total: 77 dimensions"]
    Process_Cat --> Combine
    
    Combine --> Balance["Balance Classes<br/>Random oversampling<br/>20k → 37,808 samples"]
    
    Balance --> Split["Train-Test Split<br/>80% train (30,246)<br/>20% test (7,562)<br/>Stratified"]
    
    Split --> Save["Save Artifacts<br/>Scalers, encoders<br/>Feature names"]
    
    Save --> End([Ready for Training])
    
    style Start fill:#dcfce7,stroke:#22c55e,stroke-width:3px
    style Load fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    style Inspect fill:#e0e7ff,stroke:#6366f1,stroke-width:2px
