flowchart TD
    %% User Interaction Flow - Simplified
    
    Start([User Visits Website]) --> Landing["Landing Page<br/>Overview and CTA"]
    
    Landing --> Form["Fill Career Form<br/>28 fields: academics,<br/>skills, preferences"]
    
    Form --> Submit["Submit for Prediction"]
    
    Submit --> Results["View Top 3 Careers<br/>Confidence scores<br/>Descriptions"]
    
    Results --> Options{Choose Action}
    
    Options -->|Explain| XAI["View XAI Explanation<br/>SHAP feature importance<br/>Why this career?"]
    
    Options -->|Evolution| Evolution["View Career Path<br/>Future progression<br/>Timeframes"]
    
    Options -->|Resume| Resume["Upload Resume<br/>Skill gap analysis<br/>Match percentage"]
    
    Options -->|Compare| Compare["Compare Careers<br/>Side-by-side view<br/>Requirements"]
    
    Options -->|New| Form
    
    XAI --> Options
    Evolution --> Options
    Resume --> Options
    Compare --> Options
    
    Options -->|Exit| End([Session Complete])
    
    style Start fill:#dcfce7,stroke:#22c55e,stroke-width:3px
    style Landing fill:#dbeafe,stroke:#3b82f6,stroke-width:2px
    style Choice fill:#fef3c7,stroke:#f59e0b,stroke-width:2px
    style Form fill:#e0e7ff,stroke:#6366f1,stroke-width:2px
    style Validate fill:#fef3c7,stroke:#f59e0b,stroke-width:2px
    style Submit fill:#bfdbfe,stroke:#3b82f6,stroke-width:2px
    style APICall fill:#e9d5ff,stroke:#a855f7,stroke-width:2px
    style Results fill:#dcfce7,stroke:#22c55e,stroke-width:3px
    style UserDecision fill:#fef3c7,stroke:#f59e0b,stroke-width:3px
    style XAIRequest fill:#fed7aa,stroke:#f97316,stroke-width:2px
    style XAIDisplay fill:#fed7aa,stroke:#f97316,stroke-width:2px
    style EvolutionRequest fill:#e9d5ff,stroke:#a855f7,stroke-width:2px
