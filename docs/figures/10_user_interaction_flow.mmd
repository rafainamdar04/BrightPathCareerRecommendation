    style Results fill:#dcfce7,stroke:#22c55e,stroke-width:3px
    style UserDecision fill:#fef3c7,stroke:#f59e0b,stroke-width:3px
    style XAIRequest fill:#fed7aa,stroke:#f97316,stroke-width:2px
    style XAIDisplay fill:#fed7aa,stroke:#f97316,stroke-width:2px
