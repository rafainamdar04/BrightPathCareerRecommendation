flowchart TD
    %% Resume Analysis NLP Pipeline - Simplified
    
    Start([User Uploads Resume]) --> Extract["Extract Text<br/>PDF or DOCX<br/>Clean and normalize"]
    
    Extract --> NLP["spaCy NLP Processing<br/>Tokenization, POS tagging<br/>Named entity recognition"]
    
    NLP --> Extract_Info["Extract Information<br/>• Name, contact, education<br/>• Work experience, dates<br/>• Skills and certifications"]
    
    Extract_Info --> Embed["SBERT Semantic Embedding<br/>all-MiniLM-L6-v2<br/>Resume → 384-dim vector"]
    
    Embed --> Compare["Compare with Careers<br/>Cosine similarity<br/>Skill gap analysis"]
    
    Compare --> Report["Generate Report<br/>Match score, skill gaps<br/>Recommendations"]
    
    Report --> End([Return Analysis])
    
